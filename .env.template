# ===========================================
# Histeeria Environment Variables Template
# ===========================================

# BACKEND (.env in backend/ directory)
# Copy this to backend/.env

PORT=8080
ENV=development
# PostgreSQL connection string (must have pgvector extension)
DATABASE_URL=postgres://histeeria:histeeria@localhost:5432/histeeria?sslmode=disable
# Comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Gemini API key (required for AI extraction and embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI API key (optional fallback)
OPENAI_API_KEY=
# Embedding model (default: text-embedding-004, 768 dims)
EMBEDDING_MODEL=text-embedding-004
# JWT secret (change in production!)
JWT_SECRET=change-this-to-a-secure-random-string
# Default timezone
DEFAULT_TIMEZONE=UTC

# FRONTEND (.env.local in frontend/ directory)
# Copy this to frontend/.env.local

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
